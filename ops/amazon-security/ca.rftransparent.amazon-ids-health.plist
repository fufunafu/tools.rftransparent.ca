<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ca.rftransparent.amazon-ids-health</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>/Library/Application Support/RFToolsSecurity/health.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/rf-amazon-security/maintenance.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/rf-amazon-security/maintenance.log</string>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_ALLOWED_DOMAINS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The image library is a separate Supabase project with its own user list. Its
# URL is hardcoded in public/library.html, so this key is the only value the
# deployment needs. Unset means /api/library-token returns 503 and the library
# falls back to its own sign-in box.
LIBRARY_SUPABASE_SERVICE_KEY=

# Scheduled jobs and alerts
CRON_SECRET=
CRON_ALERT_EMAIL=
RESEND_API_KEY=

# Shopify store 1. Repeat with suffixes 2 and 3 as needed.
SHOPIFY_STORE_1=
SHOPIFY_LABEL_1=
SHOPIFY_ACCESS_TOKEN_1=
SHOPIFY_CLIENT_ID_1=
SHOPIFY_CLIENT_SECRET_1=
# Use the client secret from the app that owns the Shopify App Proxy. Falls
# back to SHOPIFY_CLIENT_SECRET_1 when both integrations use the same app.
SHOPIFY_APP_PROXY_SECRET_1=
SHOPIFY_QUOTATION_ACCESS_TOKEN_1=

# Gmail OAuth application
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Legacy rollout fallbacks. New connections are saved from the in-app
# Connect/Reconnect flow and do not require these values.
GMAIL_REFRESH_TOKEN_RF=
GMAIL_REFRESH_TOKEN_GRS=
GMAIL_REFRESH_TOKEN_BC=

# Google marketing
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_GA4_PROPERTY_ID=

# Customer service scraper
SCRAPER_URL=
SCRAPER_API_KEY=

# Lead ingestion
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Employee surveys
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SURVEY_TEMPLATE_NAME=weekly_checkin
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v24.0
# Shared with InvoiceBox so its WhatsApp webhook can identify active employees.
WHATSAPP_ASSISTANT_SHARED_SECRET=
# InvoiceBox exposes the protected live assistant evaluation endpoint.
INVOICEBOX_URL=https://invoicebox-delta.vercel.app
# Used to turn pasted notes and emails into reviewable knowledge drafts.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_KNOWLEDGE_QUERY_MODEL=gpt-5.6-luna
OPENAI_KNOWLEDGE_MODEL=gpt-5.6-luna
# Optional safe test mode. Configure both values together.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_EMPLOYEE_ID=

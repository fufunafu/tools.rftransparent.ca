{
  "name": "tools-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "node scripts/validate-mobile-e2e-env.mjs && playwright test e2e/mobile.spec.ts --project=webkit-iphone-se --project=webkit-iphone --project=webkit-iphone-pro-max --project=webkit-ipad",
    "test:e2e:mobile:public": "playwright test e2e/mobile.spec.ts --grep 'mobile login' --project=webkit-iphone-se --project=webkit-iphone --project=webkit-iphone-pro-max --project=webkit-ipad",
    "test:e2e:ui": "playwright test --ui",
    "cap:sync:dev": "CI=1 CAPACITOR_SERVER_URL=http://127.0.0.1:3000 CAPACITOR_ALLOW_CLEARTEXT=1 cap sync ios",
    "cap:sync:prod": "CI=1 CAPACITOR_SERVER_URL=https://tools.rftransparent.ca CAPACITOR_ALLOW_CLEARTEXT=0 cap sync ios && npm run ios:validate-release",
    "ios:validate-release": "node scripts/validate-ios-release.mjs",
    "ios:native-smoke": "vitest run src/lib/app-biometrics.test.ts src/lib/app-geolocation.test.ts src/lib/native-runtime.test.ts && node scripts/validate-native-shell.mjs",
    "ios:build:sim": "xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug -derivedDataPath .next/ios-derived CODE_SIGNING_ALLOWED=NO build",
    "ios:build:sim:release": "xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Release -derivedDataPath .next/ios-derived-release CODE_SIGNING_ALLOWED=NO build",
    "ios:screenshots": "node scripts/capture-app-store-screenshots.mjs",
    "ios:release-check": "node scripts/validate-mobile-e2e-env.mjs && npm run check && npm run build && npm run ios:native-smoke && npm run cap:sync:prod && npm run ios:build:sim:release && npm run test:e2e:mobile",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.99.3",
    "jose": "^6.2.9",
    "leaflet": "^1.9.4",
    "next": "16.2.0",
    "openai": "^7.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.8.0",
    "resend": "^6.10.0",
    "swr": "^2.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
